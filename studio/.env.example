# ==========================================================
# ENTORNO — JP Accesorios (panel de edición / Sanity Studio)
# Copia este fichero a `.env` (Studio) o `.env.local` (web).
#
# La web lee de Sanity SOLO si tiene SANITY_PROJECT_ID.
# Si falta, la web funciona con src/data/ como respaldo.
# ==========================================================

# --- Panel (Sanity Studio) ---------------------------------
# Se encuentra en sanity.io/manage → tu proyecto → Settings → API.
# Debe empezar por una letra minúscula.
SANITY_STUDIO_PROJECT_ID=
# Dataset con el que trabajas (por defecto: production).
SANITY_STUDIO_DATASET=production
# URL de la web pública: la usa la herramienta «Importar desde Instagram».
SANITY_STUDIO_SITE_URL=https://jp-accesorios.es

# --- Web (Next.js) -----------------------------------------
# Copia estas dos al `.env.local` de la RAÍZ del proyecto.
SANITY_PROJECT_ID=
SANITY_DATASET=production
