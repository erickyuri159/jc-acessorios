# ==========================================================
# ENTORNO — jp-accesorios
# Copia este fichero a `.env.local` (desarrollo) y define las
# mismas variables en el panel de Vercel (producción).
#
# Todas son OPCIONALES: sin ellas la web funciona con el
# catálogo y los textos de `src/data/` como respaldo.
# ==========================================================

# --- Contenido (Sanity) ------------------------------------
# Sin SANITY_PROJECT_ID, la web usa src/data/ como respaldo.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Token con permiso de escritura. SOLO lo necesita el
# importador de Instagram. Es un secreto: nunca al cliente.
SANITY_API_WRITE_TOKEN=
# Secreto del webhook de Sanity: hace que «Publicar» se vea al
# instante. Debe coincidir con el de la URL del webhook.
SANITY_REVALIDATE_SECRET=

# --- Instagram ---------------------------------------------
# Token de Meta para leer el feed de la tienda.
# Permisos: instagram_basic (o instagram_content_publish).
# El token NUNCA se expone al navegador: solo lo usa la API.
INSTAGRAM_ACCESS_TOKEN=
# Versión de la Graph API (por defecto v21.0).
INSTAGRAM_GRAPH_VERSION=v21.0

# --- Dominio ------------------------------------------------
# URL base para canonicals y sitemap.
NEXT_PUBLIC_SITE_URL=https://jp-accesorios.es
